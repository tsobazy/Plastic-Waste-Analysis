# History files
.Rhistory
.Rapp.history
# Session Data files
.RData
.RDataTmp
# User-specific files
.Ruserdata
# Example code in package build process
*-Ex.R
# Output files from R CMD build
/*.tar.gz
# Output files from R CMD check
/*.Rcheck/
# RStudio files
.Rproj.user/
# produced vignettes
vignettes/*.html
vignettes/*.pdf
# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth
# knitr and R markdown default cache directories
*_cache/
/cache/
# Temporary files created by R markdown
*.utf8.md
*.knit.md
# R Environment Variables
.Renviron
# pkgdown site
docs/
# translation temp files
po/*~
# RStudio Connect folder
rsconnect/
.positai

# --- Rendered output (regenerated by `quarto render`) ---
*.html
*_files/
Report.rmarkdown

# --- macOS ---
.DS_Store

# --- Data ---
# Ignore everything in data/ EXCEPT the source dataset the dashboard reads.
# GADM boundary files are re-downloaded on first render and must not be
# committed (GADM restricts redistribution).
data/*
!data/population_plastics.csv
*.rds
*.parquet

# Duplicate of data/population_plastics.csv
/population_plastics.csv
